# Copy this file to .env (same folder) and fill in ONE option. The app works without it, in template mode.
# Any OpenAI-compatible chat API works. Check the provider's site for its current free tier and model names.

# Option A: Groq (free tier, fast). Key from https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini (free tier). Key from https://aistudio.google.com
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Option C: Ollama on your own laptop (free, offline, no key). Run: ollama pull llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
