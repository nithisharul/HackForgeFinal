# Copy this file to .env (same folder) and fill in what you need. Never commit .env.
# The app works without any of it: briefs and answers fall back to templates, and the clinical audit
# runs its deterministic checks without a model.

# --- Second Brain LLM (briefs, lessons, answers). Any OpenAI-compatible chat API. Pick ONE option.
# Option A: Ollama on this laptop (free, offline, no key). Run: ollama pull gemma3:4b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma3:4b

# Option B: Groq (free tier). Key from https://console.groq.com
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Clinical record audit model (local only; its reading never changes the audit status)
# Run: ollama pull llama3.2      (about 2 GB; nothing is downloaded automatically)
# CLINICAL_LLM_BASE_URL=http://127.0.0.1:11434
# CLINICAL_LLM_MODEL=llama3.2
# CLINICAL_LLM_TIMEOUT=60
# CLINICAL_LLM_ENABLED=1

# --- Investigator sign-in. Do not edit by hand; run:  python -m backend.app.auth add "Investigator Name"
# AUTH_SECRET=
# INVESTIGATORS=
