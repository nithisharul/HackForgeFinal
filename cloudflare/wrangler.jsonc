// Free plan: the Worker serves the React build and proxies /api/* to the laptop through a tunnel.
//   Deploy the site:   cd cloudflare && npm install && npm run deploy
//   Put the API online: start uvicorn on port 8000, then  npm run go-live  (keep it running)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claimshield-nexus",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
